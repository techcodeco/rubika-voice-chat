# Rubika API transport
RUBIKA_API_URL=
RUBIKA_API_RANDOM_DC=true
RUBIKA_API_DC_MIN=1
RUBIKA_API_DC_MAX=269
RUBIKA_API_MAX_ATTEMPTS=3
RUBIKA_API_TIMEOUT_MS=20000
RUBIKA_API_VERSION=6
RUBIKA_CLIENT_VERSION_PREFIX=WB_
RUBIKA_USER_AGENT=Mozilla/5.0 (Linux; U; Android 12; en; M2004J19C Build/SP1A.210812.016) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/110.0.0.0 Mobile Safari/537.36
RUBIKA_REFERER=https://web.rubika.ir/

# Choose ONE authentication mode:
# A) Named session: if missing, the SDK asks for phone, login code and optional 2FA.
RUBIKA_SESSION_NAME=
RUBIKA_SESSION_DATABASE=./sessions/rubika.sqlite
RUBIKA_SESSION_KEY_FILE=
RUBIKA_SESSION_ENCRYPTION_KEY=
RUBIKA_SESSION_INTERACTIVE=true
# Register device once when a new session is created; saved sessions are not re-registered.
RUBIKA_SESSION_REGISTER_DEVICE=true
# B) Direct credentials: use original jsrubi auth + Base64(JSON({version:'6',d:PEM})).
RUBIKA_AUTH=
RUBIKA_PRIVATE_KEY_B64=
# Optional for direct credentials; login-created sessions normally discover this themselves.
RUBIKA_SELF_OBJECT_GUID=

# Web client identity
RUBIKA_APP_NAME=Main
RUBIKA_APP_VERSION=4.4.34
RUBIKA_PLATFORM=Web
RUBIKA_PACKAGE=web.rubika.ir
RUBIKA_LANG_CODE=fa

# Voice behavior
VOICE_AUTO_UNMUTE=true
VOICE_ICE_TIMEOUT_MS=30000
VOICE_SEND_ACTIVITY=true
VOICE_ACTIVITY_INTERVAL_MS=2000

# Media tools
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=1
AUDIO_FRAME_MS=10
RECORDING_DIR=./recordings
RECORDING_KEEP_RAW=false
